  "warnings": [
    "1 project's current status was not at the end of its status updates, so one update was added, dated at the project's last change (BKS).",
    "1 activity row belongs to no project, or one that is not in the export, and was left out.",
    "These tables were in the export and ignored on purpose (notifications, apiTokens, sessions)."
  ],
  "unmapped": [
    {
      "field": "organizations",
      "reason": "The import goes into the firm that runs it; the Sentire Projects organisation and its name are not used."
    },
    {
      "field": "users.passwordHash",
      "reason": "A secret. It is never read, and a plan holding one is refused by the validator. People sign in to the Portal with their own accounts."
    },
    {
      "field": "users.role",
      "reason": "Sentire Projects owner, member and viewer do not map to Portal roles; the owner grants Projects:Read, Create, Update and Configure in the role editor."
    },
    {
      "field": "users.createdAt, users.lastLoginAt, users.disabledAt",
      "reason": "Portal users are separate accounts. People are matched by e-mail only."
    },
    {
      "field": "users.id",
      "reason": "An internal id. Every reference in the plan is by e-mail."
    },
    {
      "field": "sessions",
      "reason": "Login sessions of the Sentire Projects web app; temporary and tied to its cookies."
    },
    {
      "field": "apiTokens",
      "reason": "Token hashes are secrets and Sentire Projects tokens do not work on the Portal. Issue new personal tokens in the Portal."
    },
    {
      "field": "notifications",
      "reason": "A per-user inbox of short-lived messages. The Portal has no notifications table yet."
    },
    {
      "field": "projects.archivedAt",
      "reason": "The Portal keeps an archived flag only; the time of archiving is lost."
    },
    {
      "field": "issues.deletedAt",
      "reason": "The Portal keeps a deleted flag only; the time of deleting is lost. Deleted issues are still imported, flagged, so their numbers stay used."
    },
    {
      "field": "issues.fingerprint",
      "reason": "The Portal has no fingerprint column yet. The plan carries it, so the security-audit phase can match re-imports to these issues."
    },
    {
      "field": "milestones.closedAt",
      "reason": "The Portal's milestone has a state but no closing time."
    },
    {
      "field": "comments.actorKind, comments.sessionId",
      "reason": "The Portal's comment table has no actor type or session yet. The plan carries both."
    },
    {
      "field": "activities.client",
      "reason": "The Portal records a channel (web, api, mcp, github, system), worked out from the actor type here. The plan carries the original client text."
    },
    {
      "field": "activities (no project)",
      "reason": "The Portal's activity log needs a project; rows with none are left out."
    },
    {
      "field": "workSessions",
      "reason": "The Portal has no work-session table yet. The plan carries every session for the later phase that adds it."
    },
    {
      "field": "githubLinks",
      "reason": "The Portal has no GitHub link table yet. The plan carries every link."
    },
    {
      "field": "securityAudits",
      "reason": "The Portal has no audit table yet. The plan carries every audit record."
    },
    {
      "field": "projects.status, projects.statusNote",
      "reason": "The Portal takes a project's current status from its latest status update. A status update is added to the plan when the history does not already end with the current status."
    }
  ]
}
