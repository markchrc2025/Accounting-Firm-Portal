{
  "name": "@portal/projects-core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure helpers for the Projects module: markdown checklist import, issue keys and closing keywords, GitHub webhook signatures, security-audit findings mapping. No database, no network, no Nest.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
